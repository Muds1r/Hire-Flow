DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/recruitment_mvp"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_DAYS=7
PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
FRONTEND_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"

# Mail (Mailhog local: docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog — UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Hire Flow <noreply@hireflow.local>"
# Set AUTH_COOKIE_SECURE=true in production (HTTPS). Omit or false for local http.
# AUTH_COOKIE_SECURE=false
# Set AUTH_COOKIE_SECURE=true when API is HTTPS-only (production).
